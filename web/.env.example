# ---- Required ----
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/notetaker
# Public base URL of the web app (used for OAuth redirect + share links)
APP_URL=http://localhost:3000
# Random 32+ char string, used to sign OAuth state
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Transcription: mock | groq | openai | deepgram ----
# "mock" is DEMO ONLY: it does not listen to audio and emits a scripted sample conversation.
TRANSCRIPTION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
TRANSCRIPTION_LANGUAGE=en
# Groq (free tier) — one key for transcription and notes. See docs/DEPLOY-FREE.md
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible endpoint for the openai provider
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- AI notes: heuristic | groq | anthropic | openai ----
# "heuristic" is a rule-based extractor that needs no key (lower quality, conservative).
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_LLM_MODEL=gpt-4.1-mini

# ---- Google Sign-In (optional; email/password works without it) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Audio storage: local (disk) | postgres (default on Vercel) ----
AUDIO_STORE=local
AUDIO_STORAGE_DIR=./data/audio

# ---- Access ----
# Comma-separated emails allowed to sign up. Empty = anyone.
ALLOWED_EMAILS=
# Secret Vercel Cron sends to /api/cron/retention
CRON_SECRET=

# ---- Tuning ----
NOTES_INTERVAL_SEGMENTS=6
FINAL_PASS_MAX_CHARS=120000
# Comma-separated extension origins allowed to call the API, e.g. chrome-extension://abcdef...
# Leave empty to allow any chrome-extension:// origin (requests still need a valid Bearer token).
EXTENSION_ORIGINS=
